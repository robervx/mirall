{
  "name": "vlc-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Monitor de datos abiertos de València en tiempo real: movilidad, meteorología, calidad del aire, eventos e incidencias en un único mapa.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/bundle-api.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "auth:hash": "tsx scripts/auth-hash.ts",
    "marca": "tsx scripts/generar-marca.ts",
    "seed:distritos": "node scripts/seed-distritos.mjs",
    "seed:red-viaria": "tsx scripts/seed-red-viaria.ts",
    "seed:camaras-dgt": "tsx scripts/seed-camaras-dgt.ts",
    "seed:altimetria": "tsx scripts/seed-altimetria.ts",
    "seed:imbornales": "tsx scripts/seed-imbornales-distrito.ts",
    "seed:zonas-zas": "tsx scripts/seed-zonas-zas.ts",
    "snapshot:trafico-historico": "tsx scripts/snapshot-trafico-historico.ts",
    "snapshot:pulso-sombra": "tsx scripts/snapshot-pulso-sombra.ts",
    "verificar:reconciliacion-trafico-grafo": "tsx scripts/verificar-reconciliacion-trafico-grafo.ts",
    "scrape:agenda-eventos": "tsx scripts/scrape-agenda-eventos.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.74",
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@turf/circle": "^7.4.0",
    "ai": "^7.0.105",
    "dashjs": "^5.2.1",
    "maplibre-gl": "^6.10.0",
    "rbush": "^4.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.7.0",
    "@types/rbush": "^4.0.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.21.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vercel": "^59.10.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.0"
  }
}
